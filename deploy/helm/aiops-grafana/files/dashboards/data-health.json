                        "color": "dark-red",
                        "index": 2
                      },
                      "infrastructure_error": {
                        "text": "整輪失敗（基礎設施／資料斷流）",
                        "color": "red",
                        "index": 3
                      },
                      "workflow_error": {
                        "text": "管線定義載入失敗（沒有執行）",
                        "color": "orange",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
