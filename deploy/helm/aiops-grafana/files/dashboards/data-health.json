    {
      "id": 3,
      "type": "state-timeline",
      "title": "每條資料流的狀態時間軸（用上方「服務」下拉選單看單一服務的歷史）",
      "description": "一列一條資料流（管線 / 服務 / 查詢），顏色 = 狀態。最後一次檢查之後是空白：平台沒有再檢查到這條資料流（管線沒跑、整輪在抓到它之前就失敗、或紀錄寫不進資料庫），不是「正常」。兩段不同狀態之間畫成前一個狀態延續到下一次紀錄；要精確的起訖時間看最下面的表（開始、最後確認）。預設只畫時間範圍內出過問題的資料流。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aiops-platform-db"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aiops-platform-db"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT t AS \"time\", stream AS metric, v AS value FROM (\n  SELECT CASE WHEN h.started_at < $__timeFrom() THEN $__timeFrom() ELSE h.started_at END AS t, h.pipeline || ' / ' || h.entity || ' / ' || h.query AS stream, CASE h.status WHEN 'ok' THEN 0 WHEN 'no_data' THEN 1 WHEN 'never_seen' THEN 2 WHEN 'config_error' THEN 3 WHEN 'unreachable' THEN 4 WHEN 'error' THEN 5 END AS v\n  FROM data_stream_health h WHERE h.last_checked_at >= $__timeFrom() AND h.started_at <= $__timeTo() AND h.pipeline IN ($pipeline) AND h.entity IN ($service) AND ('$scope' = 'all' OR EXISTS (SELECT 1 FROM data_stream_health p WHERE p.pipeline = h.pipeline AND p.entity = h.entity AND p.query = h.query AND p.status <> 'ok' AND p.last_checked_at >= $__timeFrom() AND p.started_at <= $__timeTo()))\n  UNION\n  SELECT h.last_checked_at AS t, h.pipeline || ' / ' || h.entity || ' / ' || h.query AS stream, CASE h.status WHEN 'ok' THEN 0 WHEN 'no_data' THEN 1 WHEN 'never_seen' THEN 2 WHEN 'config_error' THEN 3 WHEN 'unreachable' THEN 4 WHEN 'error' THEN 5 END AS v\n  FROM data_stream_health h WHERE h.last_checked_at >= $__timeFrom() AND h.started_at <= $__timeTo() AND h.pipeline IN ($pipeline) AND h.entity IN ($service) AND ('$scope' = 'all' OR EXISTS (SELECT 1 FROM data_stream_health p WHERE p.pipeline = h.pipeline AND p.entity = h.entity AND p.query = h.query AND p.status <> 'ok' AND p.last_checked_at >= $__timeFrom() AND p.started_at <= $__timeTo()))\n  UNION\n  SELECT h.last_checked_at + interval '1 second' AS t, h.pipeline || ' / ' || h.entity || ' / ' || h.query AS stream, -1 AS v\n  FROM data_stream_health h WHERE h.is_current AND h.last_checked_at >= $__timeFrom() AND h.started_at <= $__timeTo() AND h.pipeline IN ($pipeline) AND h.entity IN ($service) AND ('$scope' = 'all' OR EXISTS (SELECT 1 FROM data_stream_health p WHERE p.pipeline = h.pipeline AND p.entity = h.entity AND p.query = h.query AND p.status <> 'ok' AND p.last_checked_at >= $__timeFrom() AND p.started_at <= $__timeTo()))\n) x ORDER BY 1"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "正常",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "沒有資料（斷流）",
                  "color": "red",
                  "index": 1
                },
                "2": {
                  "text": "從未有過資料",
                  "color": "purple",
                  "index": 2
                },
                "3": {
                  "text": "設定或查詢錯誤",
                  "color": "orange",
                  "index": 3
                },
                "4": {
                  "text": "資料源連不上",
                  "color": "dark-red",
                  "index": 4
                },
                "5": {
                  "text": "其他錯誤",
                  "color": "yellow",
                  "index": 5
                },
                "-1": {
                  "text": "沒有紀錄（平台沒有檢查到）",
                  "color": "transparent",
                  "index": 6
                }
              }
            }
          ],
