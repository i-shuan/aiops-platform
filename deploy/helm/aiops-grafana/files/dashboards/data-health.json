  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "目前有問題的資料流",
      "description": "每條資料流最新的狀態不是「正常」的都列在這裡（不用先選服務）。沒有資料（斷流）= 以前有資料、現在沒有；從未有過資料 = 平台從來沒收過它的資料（多半是還沒埋點、或查詢對不到）；設定或查詢錯誤 = 資料源說查詢不合法或欄位不存在。這張表是空的 = 目前每條資料流都有資料進來。只看畫面右上角的時間範圍內。最後一次檢查早於時間範圍的資料流不會出現（那是管線沒在跑，看下一張表）。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aiops-platform-db"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aiops-platform-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT pipeline AS \"管線\", entity AS \"服務\", query AS \"查詢\", status AS \"狀態\", message AS \"訊息\",\n  started_at AS \"從什麼時候開始\", last_checked_at AS \"最後確認\", checks AS \"連續幾輪\"\nFROM data_stream_health\nWHERE is_current AND status <> 'ok' AND $__timeFilter(last_checked_at) AND pipeline IN ($pipeline) AND entity IN ($service)\nORDER BY started_at"
        }
      ],
      "options": {
