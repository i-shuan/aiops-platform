      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aiops-platform-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT '資料流' AS \"層級\", pipeline AS \"管線\", entity AS \"服務\", query AS \"查詢\", message AS \"訊息\",\n  started_at AS \"開始\", last_checked_at AS \"最後一次\", checks AS \"幾輪\"\nFROM data_stream_health\nWHERE status = 'config_error' AND last_checked_at >= $__timeFrom() AND started_at <= $__timeTo() AND pipeline IN ($pipeline) AND entity IN ($service)\nUNION ALL\nSELECT '管線定義' AS \"層級\", pipeline AS \"管線\", '' AS \"服務\", '' AS \"查詢\", message AS \"訊息\",\n  MIN(run_at) AS \"開始\", MAX(run_at) AS \"最後一次\", COUNT(*) AS \"幾輪\"\nFROM pipeline_runs\nWHERE failure_type = 'workflow_error' AND $__timeFilter(run_at) AND pipeline IN ($pipeline)\nGROUP BY pipeline, message\nORDER BY 6 DESC\nLIMIT 500"
        }
