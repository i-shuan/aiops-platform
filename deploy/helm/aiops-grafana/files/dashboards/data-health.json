    {
      "id": 4,
      "type": "state-timeline",
      "title": "管線每輪的執行結果",
      "description": "一列一條管線，顏色 = 執行結果（時間範圍長的時候一格裡有好幾輪，顯示其中最嚴重的）。最後一輪之後是空白：沒有任何一輪留下紀錄。中間少跑的輪次畫成前一輪的結果延續；要看有沒有少跑，比對上一張表的「範圍內輪數」。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aiops-platform-db"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aiops-platform-db"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT t AS \"time\", pipeline AS metric, v AS value FROM (\n  SELECT $__timeGroup(run_at, $__interval) AS t, pipeline, MAX(CASE COALESCE(NULLIF(failure_type, ''), status) WHEN 'ok' THEN 0 WHEN 'degraded' THEN 1 WHEN 'error' THEN 2 WHEN 'infrastructure_error' THEN 3 WHEN 'workflow_error' THEN 4 END) AS v\n  FROM pipeline_runs WHERE $__timeFilter(run_at) AND pipeline IN ($pipeline) GROUP BY 1, 2\n  UNION\n  SELECT extract(epoch from MAX(run_at)) + 1 AS t, pipeline, -1 AS v\n  FROM pipeline_runs WHERE $__timeFilter(run_at) AND pipeline IN ($pipeline) GROUP BY pipeline\n) x ORDER BY 1"
        }
      ],
