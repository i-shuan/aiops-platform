{
  "uid": "apm-overview",
  "title": "APM 總覽：metrics → trace → log",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "Asia/Taipei",
  "refresh": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "apm",
    "apm"
  ],
  "description": "公司 Elastic APM 的 metrics、trace、log（上半）接 AIOps 合成的事故與根因（下半）。資料來源與欄位：aiops-engine/configs/apm/README.md。",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "服務",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "apm-metrics"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "query": "{\"find\": \"terms\", \"field\": \"service.name\", \"size\": 50}",
        "definition": "{\"find\": \"terms\", \"field\": \"service.name\", \"size\": 50}",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "① Metrics：每支 API 的 p95 延遲（APM 的每分鐘直方圖）",
      "description": "metrics-apm.transaction.1m-*：apm-server 每分鐘算好的直方圖（transaction.duration.histogram，微秒）。引擎的 p95 規則（超過 2 秒）讀的是同一份資料。",
      "datasource": {
        "type": "elasticsearch",
        "uid": "apm-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "apm-metrics"
          },
          "query": "service.name:$service AND metricset.name:transaction AND transaction.type:request",
          "alias": "",
          "metrics": [
            {
              "id": "1",
              "type": "percentiles",
              "field": "transaction.duration.histogram",
              "settings": {
                "percents": [
                  "95"
                ]
              }
            }
          ],
          "bucketAggs": [
            {
              "id": "3",
              "type": "terms",
              "field": "transaction.name",
              "settings": {
                "size": "6",
                "order": "desc",
                "orderBy": "_term",
                "min_doc_count": "1"
              }
            },
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "spanNulls": true,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "µs"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "② Trace：請求數，依結果（failure 是失敗）",
      "description": "traces-apm-*：processor.event 是 transaction 的文件，一筆一個請求（取樣到的）。失敗的比例上升，就是上面延遲變高的那段時間。",
      "datasource": {
        "type": "elasticsearch",
        "uid": "apm-traces"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "apm-traces"
          },
          "query": "service.name:$service AND processor.event:transaction",
          "alias": "",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "3",
              "type": "terms",
              "field": "event.outcome",
              "settings": {
                "size": "3",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            },
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "spanNulls": true,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "③ Trace：每一段自己花的平均時間（DB、下游呼叫）",
      "description": "traces-apm-*：processor.event 是 span 的文件，依 span.name 分。哪一段（例如 SELECT LOT_HISTORY）變長，慢就慢在那裡。",
      "datasource": {
        "type": "elasticsearch",
        "uid": "apm-traces"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "apm-traces"
          },
          "query": "service.name:$service AND processor.event:span",
          "alias": "",
          "metrics": [
            {
              "id": "1",
              "type": "avg",
              "field": "span.duration.us"
            }
          ],
          "bucketAggs": [
            {
              "id": "3",
              "type": "terms",
              "field": "span.name",
              "settings": {
                "size": "6",
                "order": "desc",
                "orderBy": "_term",
                "min_doc_count": "1"
              }
            },
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "spanNulls": true,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "µs"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "③ Trace：最慢的請求（拿 trace.id 去下面的 log 找）",
      "description": "耗時超過 1 秒的 transaction，新的在前；trace.id 貼到下面 ④ 的搜尋框，就是這個請求的 log。",
      "datasource": {
        "type": "elasticsearch",
        "uid": "apm-traces"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "apm-traces"
          },
          "query": "service.name:$service AND processor.event:transaction AND transaction.duration.us:>=1000000",
          "alias": "",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "30"
              }
            }
          ],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "transaction.duration.us"
            },
            "properties": [
              {
                "id": "unit",
                "value": "µs"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "@timestamp": true,
              "service.name": true,
              "transaction.name": true,
              "transaction.duration.us": true,
              "event.outcome": true,
              "trace.id": true
            },
            "indexByName": {
              "@timestamp": 0,
              "service.name": 1,
              "transaction.name": 2,
              "transaction.duration.us": 3,
              "event.outcome": 4,
              "trace.id": 5
            },
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "④ Log：APM 回報的例外，每一筆帶 trace.id（跟 ③ 的 trace 對得起來）",
      "description": "logs-apm.*：agent 回報的例外（processor.event: error），有開 log shipping 的服務還有一般 log。",
      "datasource": {
        "type": "elasticsearch",
        "uid": "apm-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "apm-logs"
          },
          "query": "service.name:$service",
          "alias": "",
          "metrics": [
            {
              "id": "1",
              "type": "logs",
              "settings": {
                "limit": "100"
              }
            }
          ],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ]
}
