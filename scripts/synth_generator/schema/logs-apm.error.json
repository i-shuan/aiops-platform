{
  "source": "手寫的備用 mapping（不是從叢集抓的）：欄位型別照現有文件格式與 Elastic APM 慣例。載入前請先跑 es_writer --fetch-schema 用唯讀 key 抓既有 scn 資料串流的真實 mapping 覆蓋這個檔",
  "mappings": {
    "dynamic": true,
    "properties": {
      "@timestamp": {
        "type": "date"
      },
      "service": {
        "properties": {
          "name": {
            "type": "keyword"
          },
          "environment": {
            "type": "keyword"
          },
          "version": {
            "type": "keyword"
          },
          "node": {
            "properties": {
              "name": {
                "type": "keyword"
              }
            }
          }
        }
      },
      "labels": {
        "properties": {
          "dept": {
            "type": "keyword"
          },
          "group": {
            "type": "keyword"
          }
        }
      },
      "kubernetes": {
        "properties": {
          "pod": {
            "properties": {
              "name": {
                "type": "keyword"
              }
            }
          },
          "namespace": {
            "type": "keyword"
          }
        }
      },
      "agent": {
        "properties": {
          "name": {
            "type": "keyword"
          }
        }
      },
      "processor": {
        "properties": {
          "event": {
            "type": "keyword"
          }
        }
      },
      "data_stream": {
        "properties": {
          "type": {
            "type": "constant_keyword"
          },
          "dataset": {
            "type": "constant_keyword"
          },
          "namespace": {
            "type": "constant_keyword"
          }
        }
      },
      "timestamp": {
        "properties": {
          "us": {
            "type": "long"
          }
        }
      },
      "trace": {
        "properties": {
          "id": {
            "type": "keyword"
          }
        }
      },
      "parent": {
        "properties": {
          "id": {
            "type": "keyword"
          }
        }
      },
      "transaction": {
        "properties": {
          "id": {
            "type": "keyword"
          },
          "name": {
            "type": "keyword"
          },
          "type": {
            "type": "keyword"
          },
          "sampled": {
            "type": "boolean"
          }
        }
      },
      "error": {
        "properties": {
          "id": {
            "type": "keyword"
          },
          "grouping_key": {
            "type": "keyword"
          },
          "culprit": {
            "type": "keyword"
          },
          "exception": {
            "properties": {
              "type": {
                "type": "keyword"
              },
              "message": {
                "type": "text",
                "fields": {
                  "keyword": {
                    "type": "keyword",
                    "ignore_above": 1024
                  }
                }
              },
              "handled": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "message": {
        "type": "text"
      },
      "log": {
        "properties": {
          "level": {
            "type": "keyword"
          }
        }
      }
    }
  }
}
