{
  "source": "手寫的備用 mapping（不是從叢集抓的）：欄位型別照現有文件格式與 Elastic APM 慣例。載入前請先跑 es_writer --fetch-schema 用唯讀 key 抓既有 scn 資料串流的真實 mapping 覆蓋這個檔",
  "mappings": {
    "dynamic": true,
    "properties": {
      "@timestamp": {
        "type": "date"
      },
      "service": {
        "properties": {
          "name": {
            "type": "keyword"
          },
          "environment": {
            "type": "keyword"
          },
          "version": {
            "type": "keyword"
          },
          "node": {
            "properties": {
              "name": {
                "type": "keyword"
              }
            }
          }
        }
      },
      "labels": {
        "properties": {
          "dept": {
            "type": "keyword"
          },
          "group": {
            "type": "keyword"
          }
        }
      },
      "kubernetes": {
        "properties": {
          "pod": {
            "properties": {
              "name": {
                "type": "keyword"
              }
            }
          },
          "namespace": {
            "type": "keyword"
          }
        }
      },
      "agent": {
        "properties": {
          "name": {
            "type": "keyword"
          }
        }
      },
      "processor": {
        "properties": {
          "event": {
            "type": "keyword"
          }
        }
      },
      "data_stream": {
        "properties": {
          "type": {
            "type": "constant_keyword"
          },
          "dataset": {
            "type": "constant_keyword"
          },
          "namespace": {
            "type": "constant_keyword"
          }
        }
      },
      "event": {
        "properties": {
          "outcome": {
            "type": "keyword"
          },
          "ingested": {
            "type": "date"
          },
          "success_count": {
            "properties": {
              "sum": {
                "type": "double"
              },
              "value_count": {
                "type": "long"
              }
            }
          }
        }
      },
      "metricset": {
        "properties": {
          "name": {
            "type": "keyword"
          },
          "interval": {
            "type": "keyword"
          }
        }
      },
      "transaction": {
        "properties": {
          "name": {
            "type": "keyword"
          },
          "type": {
            "type": "keyword"
          },
          "root": {
            "type": "boolean"
          },
          "result": {
            "type": "keyword"
          },
          "duration": {
            "properties": {
              "histogram": {
                "type": "histogram"
              },
              "summary": {
                "properties": {
                  "sum": {
                    "type": "double"
                  },
                  "value_count": {
                    "type": "long"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
