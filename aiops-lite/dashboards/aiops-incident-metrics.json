            {
              "field": "@timestamp",
              "id": "2",
              "settings": {
                "interval": "15s",
                "min_doc_count": "0",
                "trimEdges": "0"
              },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "elasticsearch",
            "uid": "${DS_FACTORY_ES}"
          },
          "metrics": [
            {
              "field": "queue_depth",
              "id": "1",
              "type": "max"
            }
          ],
          "query": "service.name:mq-broker",
          "refId": "A",
